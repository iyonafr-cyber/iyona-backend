# ── App ──────────────────────────────────────────────────────────────────────
APPNAME=Iyona AI
PORT=4000
NODE_ENV=production
# LOG_LEVEL=info

# Public URLs (login redirects, Stripe return URLs, CORS).
FRONTEND_BASE_URL=
ADMIN_WEB_ORIGIN=
# Comma-separated extra origins (localhost is already allowed in code).
ALLOWED_ORIGINS=

# ── Mongo ────────────────────────────────────────────────────────────────────
MONGO_URL=

# ── Secrets ──────────────────────────────────────────────────────────────────
# ENCRYPTION_KEY encrypts BYO Supabase creds, GitHub tokens, and admin LLM keys
# at rest. Changing it on a database that already has ciphertext makes those
# rows unreadable.
ENCRYPTION_KEY=
JWT_SECRET=
JWT_AccessTokenExpiry=15m
JWT_RefreshTokenExpiry=7d
# Pepper for hashed user API keys. Changing it invalidates existing keys.
API_KEY_PEPPER=

# ── Google OAuth (login / signup) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (Connect GitHub in the workspace — not shown on login/signup)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_INTEGRATION_REDIRECT_URI=

# ── GitHub repos for generated apps ──────────────────────────────────────────
# PAT-first: repos are created under the authenticated GitHub user (private).
# Set IYONA_GITHUB_ORG to create them under an org instead (Cursor GitHub App
# must cover that org).
# Resolution order: GITHUB_PAT → IYONA_GITHUB_TOKEN → legacy JARVIS_GITHUB_TOKEN.
# The JARVIS_* names still work as a fallback so deploys don't break between
# config updates; fill the IYONA_* names and leave JARVIS_* empty on new setups.
GITHUB_PAT=
IYONA_GITHUB_TOKEN=
IYONA_GITHUB_ORG=
# Legacy (kept as fallback only — leave empty unless migrating an old deploy):
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_ORG=

# ── Vercel (preview + deploy of generated apps) ──────────────────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Same secret as Vercel "Protection Bypass for Automation" so preview iframes work.
VERCEL_DEPLOYMENT_PROTECTION_BYPASS=
VERCEL_WEBHOOK_SECRET=

# ── AWS S3 (prompt images, project assets) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time welcome top-up. Omit for default 100; set 0 to disable.
SIGNUP_BONUS_CREDITS=

# ── Mail (optional; invitations / password reset) ────────────────────────────
RESEND_API_KEY=
MAIL_FROM=

# ── Cursor Cloud Agents ──────────────────────────────────────────────────────
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com
# Use composer-2.5. Not composer-2.5-fast.
CURSOR_AGENT_MODEL_ID=composer-2.5
CURSOR_REPAIR_MAX_ATTEMPTS=3
CURSOR_RUN_TIMEOUT_MS=900000
CURSOR_ASK_TIMEOUT_MS=300000

# LLM provider keys (OpenAI / Anthropic / Google) are stored in Mongo via the
# admin panel (`/provider-keys` → POST /admin/ai-provider-keys). ENCRYPTION_KEY
# is required so those secrets are encrypted at rest. Do not put OPENAI_API_KEY
# (or similar) here — the app does not read them from env.

# ── Supabase (decision 07: BYO database) ─────────────────────────────────────
# Owners connect their own project from Project settings → Database.
# Platform-managed provisioning is dormant. Leave false unless you re-enable it.
SUPABASE_MANAGED_PROVISIONING=false
# Only used when SUPABASE_MANAGED_PROVISIONING=true.
SUPABASE_MGMT_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_DEFAULT_REGION=us-east-1

# ── Optional ─────────────────────────────────────────────────────────────────
# Preview host suffix for generated apps (code default is still jarvis.site).
# PREVIEW_ALIAS_DOMAIN=
# WorkOS SSO (login page SSO is a no-op until these are set).
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_REDIRECT_URI=
# PUBLIC_FRONTEND_URL=
# PUBLIC_BACKEND_URL=
# SENTRY_DSN=

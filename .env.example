# app
APPNAME=
# port
PORT=
# swagger
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
# mongoose
MONGO_URL=
# crypto js
ENCRYPTION_KEY=
# jwt
JWT_SECRET=
JWT_AccessTokenExpiry=
JWT_RefreshTokenExpiry=
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Vercel
VERCEL_TOKEN=
# Optional — same secret as Vercel "Protection Bypass for Automation" on the preview project(s), so iframe preview URLs get ?x-vercel-protection-bypass=…
VERCEL_DEPLOYMENT_PROTECTION_BYPASS=
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
# Scaffold tarballs live under the same bucket (default prefix jarvis-scaffold/) — see jarvis-templates/scripts/publish-scaffold-to-s3.sh
JARVIS_SCAFFOLD_S3_PREFIX=jarvis-scaffold
# Resolve semver from S3 latest.json on each manifest lookup (codegen, patch, deploy). Omit or any value except 0/false.
# Set TEMPLATES_FOLLOW_LATEST=0 to pin to templateVersion stored on the project only.
# TEMPLATES_FOLLOW_LATEST=
# How long to cache latest.json (ms). Default when unset is 0 = always re-fetch so new scaffold uploads apply immediately during AI builds.
TEMPLATES_LATEST_POINTER_TTL_MS=0
# Stripe
STRIPE_SECRET_KEY=
# One-time welcome top-up for new accounts (top-up bucket). Omit or leave blank for default 100; set to 0 to disable.
SIGNUP_BONUS_CREDITS=
# LLM: configure OpenAI, Anthropic, and Google keys in MongoDB via the
# platform admin panel (`/provider-keys` in jarvis-admin → POST /admin/ai-provider-keys).
# ENCRYPTION_KEY is required so provider secrets are stored encrypted at rest.

# ── GitHub → Cursor → Vercel pipeline ────────────────────────────────────────
# PAT-first: repos are created under the authenticated GitHub user (private by default).
# Set JARVIS_GITHUB_ORG only if you want repos under an org instead (Cursor GitHub App must cover that org).
GITHUB_PAT=
# Legacy/alternate token name; ignored when GITHUB_PAT is set.
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_ORG=

# Cursor Cloud Agents API
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com
# Agent model. Use composer-2.5 (+ fast param in CursorService if needed). Not composer-2.5-fast.
CURSOR_AGENT_MODEL_ID=composer-2.5
# Max Vercel-build-fail → Cursor-repair iterations per revision (default 3).
CURSOR_REPAIR_MAX_ATTEMPTS=3
# Hard timeout per Cursor agent run in ms (default 15 minutes).
CURSOR_RUN_TIMEOUT_MS=900000
# Hard timeout for a read-only codebase question (POST workspace/ask) in ms (default 5 minutes).
# The HTTP request is held for up to this long, so keep any proxy/gateway timeout above it.
CURSOR_ASK_TIMEOUT_MS=300000

# ── Supabase (decision 07: BYO database) ─────────────────────────────────────
# Owners connect their OWN Supabase project from Project settings → Database
# (POST /projects/:id/supabase/connect). Nothing below is required for that.
#
# Jarvis-managed provisioning (a Supabase project per app, created in the
# platform org) is DORMANT. The code is kept for a future paid hosted-database
# tier. Set to true ONLY to re-enable it — it also needs the two tokens below,
# and it is subject to the Supabase free-tier cap of 2 active projects per org.
SUPABASE_MANAGED_PROVISIONING=false
# Only used when SUPABASE_MANAGED_PROVISIONING=true.
SUPABASE_MGMT_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_DEFAULT_REGION=us-east-1

# Copy to `simple-cursor-repo-flow.env` (same folder) or set in root `.env`
#
# Production parity (same as RepoService — private repo under org):
JARVIS_GITHUB_ORG=
JARVIS_GITHUB_TOKEN=

# Cursor Cloud Agents API
CURSOR_API_KEY=

# Optional fallback: personal account repo (no org). Do not set JARVIS_GITHUB_TOKEN if you use this path only.
# GITHUB_PAT=

# Optional
# GITHUB_REPO_NAME=my-portfolio
# Default startingRef is branch main. Override with a branch/tag/SHA, or set:
# CURSOR_STARTING_REF_USE_COMMIT_SHA=1   # use tip commit SHA of main (Cursor often mis-validates SHAs; prefer leaving unset)
# CURSOR_STARTING_REF=refs/heads/main
# Extra ms after GitHub shows main before calling Cursor (default 15000).
# CURSOR_POST_PUSH_SETTLE_MS=15000
# Retries when Cursor returns branch/GitHub lag errors (default 8, max 12).
# CURSOR_CREATE_MAX_ATTEMPTS=8
# CURSOR_API_BASE_URL=https://api.cursor.com
# CURSOR_AGENT_MODEL_ID=composer-2
# Merge policy (squash, always merge) is fixed in simple-cursor-repo-flow.ts — same as CursorService.
# Optional: overrides default Cloud Agent instructions (one line; quote for spaces).
# AGENT_TASK=Fix syntax/import/path errors and logic gaps; fix broken links (routes, hrefs, assets); fix CSS/layout/a11y; align package.json, tsconfig, and Vite so npm install, dev, and build run smoothly. Minimal diffs; no secrets or live API calls.

# Personal-repo only: CURSOR_FLOW_PRIVATE_REPO=1   # org flow is always private (server default)

# If POST /v1/agents fails on branch/default-branch: link GitHub in Cursor Dashboard → Integrations;
# for JARVIS_GITHUB_ORG install the Cursor GitHub App on that org.

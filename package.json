{
  "name": "jarvis-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "stripe:seed": "ts-node -r tsconfig-paths/register src/stripe/stripe-seed.command.ts",
    "promote:admin": "ts-node -r tsconfig-paths/register scripts/promote-admin.ts",
    "projects:purge-legacy": "ts-node -r tsconfig-paths/register scripts/purge-legacy-projects.ts",
    "projects:purge-all": "ts-node -r tsconfig-paths/register scripts/purge-all-projects.ts",
    "projects:purge-user": "ts-node -r tsconfig-paths/register scripts/purge-user-projects.ts",
    "vercel:deployment-logs": "ts-node -r tsconfig-paths/register scripts/fetch-vercel-deployment-logs.ts",
    "cursor:simple-repo-flow": "ts-node -r tsconfig-paths/register scripts/simple-cursor-repo-flow.ts",
    "spec-build:smoke": "ts-node -r tsconfig-paths/register scripts/spec-build-smoke.ts",
    "github:validate-pat": "ts-node -r tsconfig-paths/register scripts/validate-github-pat.ts",
    "cursor:validate-github": "ts-node -r tsconfig-paths/register scripts/validate-cursor-github.ts",
    "cursor:ask-smoke": "ts-node -r tsconfig-paths/register scripts/cursor-ask-smoke.ts",
    "cursor:chat-round-smoke": "ts-node -r tsconfig-paths/register scripts/cursor-chat-round-smoke.ts",
    "completeness": "ts-node -r tsconfig-paths/register scripts/check-completeness.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/lib-storage": "^3.966.0",
    "@aws-sdk/s3-request-presigner": "^3.966.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@octokit/rest": "^20.1.2",
    "@sentry/node": "^10.49.0",
    "@types/multer": "^2.0.0",
    "@types/passport-github2": "^1.2.9",
    "@types/uuid": "^9.0.8",
    "@workos-inc/node": "^8.13.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "franc": "^6.2.0",
    "mongoose": "^9.0.2",
    "multer": "^2.0.2",
    "nestjs-pino": "^4.6.1",
    "openai": "^6.17.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "picomatch": "^4.0.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serverless-http": "^4.0.0",
    "stripe": "^21.0.1",
    "tar": "^7.5.13",
    "ts-morph": "^28.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "@types/supertest": "^6.0.2",
    "@types/tar": "^6.1.13",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!franc|trigram-utils)/"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
